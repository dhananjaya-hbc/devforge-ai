# --- App ---
ENVIRONMENT=development

# --- Database ---
POSTGRES_USER=devforge
POSTGRES_PASSWORD=devforge
POSTGRES_DB=devforge
DATABASE_URL=postgresql+psycopg://devforge:devforge@postgres:5432/devforge

# --- LLM (open-weight models only) ---
# groq     - Llama 3.3 70B hosted on Groq. Free key: https://console.groq.com/keys
# ollama   - fully local inference, requires Ollama running (no key needed)
# simulator - canned fixtures for offline tests ONLY, never for demos or metrics
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Only used when LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
